# =============================================================================
# NEXO — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA faça commit do `.env.local` (ele está no .gitignore).
# =============================================================================

# --- Supabase (Project Settings → API) ---------------------------------------
# URL do projeto, ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "publishable" (sb_publishable_...) ou a antiga "anon".
# É segura no navegador porque o banco usa Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Inteligência artificial (Anthropic Claude) -------------------------------
# Chave criada em https://console.anthropic.com — usada SOMENTE no servidor.
ANTHROPIC_API_KEY=
# Modelo (opcional). Padrão: claude-haiku-5-5 (rápido e de baixo custo).
# Alternativa mais capaz: claude-opus-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Aplicação -----------------------------------------------------------------
# URL pública do site (usada no link de confirmação de e-mail).
# Local: http://localhost:3000 · Vercel: https://seu-projeto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
