# =============================================================================
# NEXO — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA faça commit do `.env.local` (ele está no .gitignore).
# =============================================================================

# --- Supabase (botão Connect → App Frameworks → Next.js) ----------------------
# URL do projeto, ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "publishable" (sb_publishable_...) ou a antiga "anon".
# É segura no navegador porque o banco usa Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Inteligência artificial — Google Gemini (cota gratuita) -----------------
# Chave criada em https://aistudio.google.com/apikey — usada SOMENTE no servidor.
# Atenção: na cota gratuita, o Google pode usar os textos enviados para melhorar
# os produtos dele. Não use dados sensíveis.
GEMINI_API_KEY=
# Modelo (opcional). Padrão: gemini-3.5-flash-lite (gratuito, rápido).
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Alternativa paga — Anthropic Claude (opcional) ---------------------------
# Só é usada se GEMINI_API_KEY estiver vazia, ou se AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# AI_PROVIDER=gemini

# --- Aplicação -----------------------------------------------------------------
# URL pública do site (usada no link de confirmação de e-mail).
# Local: http://localhost:3000 · Vercel: https://seu-projeto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
